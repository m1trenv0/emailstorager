# MongoDB Database Connection
# Replace with your MongoDB connection string
DATABASE_URL="mongodb://localhost:27017/emailstorager"

# Example for MongoDB Atlas:
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/emailstorager?retryWrites=true&w=majority"

# Example for local MongoDB:
# DATABASE_URL="mongodb://localhost:27017/emailstorager"

# Authentication - JWT Secrets
# Generate unique random strings for production
# You can generate them with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your-access-secret-key-replace-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-replace-in-production"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Node Environment
NODE_ENV="development"

# 17TRACK API Configuration
# Get your API key from: https://api.17track.net/
# Free plan available with limited requests
# Used for tracking AliExpress and other package deliveries
TRACK17_API_KEY="your-17track-api-key-here"
